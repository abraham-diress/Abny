# Copy to .env.local (gitignored). NEVER commit .env.local.

# Where the FastAPI server (Abraham) or the mock server runs.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Matterport Showcase SDK key (from /costar-keys). Needed for the 3D tour only.
NEXT_PUBLIC_MATTERPORT_SDK_KEY=

# Map basemap style (MapLibre). Default is OpenFreeMap (no key, needs internet). "offline" = pins only.
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Matterport Model API key + token (from /costar-keys). Server-side only: `npm run mock:rooms`
# uses them to fetch real room outlines for the mock (written to the gitignored .generated/ folder).
MATTERPORT_API_TOKEN_ID=
MATTERPORT_API_TOKEN_SECRET=
