{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mock": "tsx watch mock-server/index.ts",
    "dev:mock": "concurrently -n mock,web -c yellow,cyan \"npm:mock\" \"npm:dev\"",
    "typecheck": "tsc --noEmit",
    "mock:rooms": "tsx mock-server/fetch-rooms.ts",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@matterport/sdk": "^1.6.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "hono": "^4.13.18",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
