# Copy to .env and fill in. NEVER commit .env.
# Keys come from the CoStar Discord bot (/costar-keys) and your AWS/Anthropic accounts.

# --- Demo -------------------------------------------------------------------
# 1 = replay the cached demo run (works offline)
DEMO=0

# --- LLM (agent, brief parsing, vision inspection) ---------------------------
# bedrock | anthropic
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
# Verify the exact Claude model ID available to us in the Bedrock console.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Used when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Standard AWS credentials (or use an AWS profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Image generation (Reimaginer) -------------------------------------------
IMAGE_PROVIDER=bedrock_nova
# Verify availability in the Bedrock console (gate G3).
IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
# inpaint (repaint only the furniture area) | condition (generate from the sketch) | preview (no AI, guide image)
HERO_MODE=inpaint
# 1 = black mask pixels get repainted. If G3 shows furniture outside the boxes, set 0.
NOVA_MASK_BLACK_IS_EDIT=1
# 1 = Claude vision scores realism/plan adherence of hero images (uses LLM_PROVIDER)
SCORER_LLM=0
# Matterport camera height above the floor, used when room floor heights aren't available
PANO_CAMERA_HEIGHT_M=1.55

# --- CoStar / Matterport / Vexcel (from /costar-keys) --------------------------
# Folder where the CoStar data dump is unpacked (default: data/costar_raw)
COSTAR_DATA_DIR=
# Matterport Model API credentials (names may differ in the key email; map them here)
MATTERPORT_API_TOKEN_ID=
MATTERPORT_API_TOKEN_SECRET=
# Matterport Showcase SDK key (frontend also needs it: NEXT_PUBLIC_MATTERPORT_SDK_KEY in web/.env.local)
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=

# --- Server / funnel -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
FUNNEL_FILTER_LIMIT=200
FUNNEL_INSPECT_TOP=20
FUNNEL_FIT_TOP=5
