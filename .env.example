# Copy to .env and fill in. NEVER commit .env.
# Keys come from the CoStar Discord bot (/costar-keys) and your AWS/Anthropic accounts.

# --- Demo -------------------------------------------------------------------
# 1 = replay the cached demo run (works offline)
DEMO=0

# --- LLM (agent, brief parsing, vision inspection) ---------------------------
# bedrock | anthropic
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
# Verify the exact Claude model ID available to us in the Bedrock console.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Used when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Standard AWS credentials (or use an AWS profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Image generation (Reimaginer) -------------------------------------------
IMAGE_PROVIDER=bedrock_nova
# Verify availability in the Bedrock console (gate G3).
IMAGE_MODEL_ID=amazon.nova-canvas-v1:0

# --- CoStar / Matterport / Vexcel (from /costar-keys) --------------------------
# Folder where the CoStar hackathon kit is unzipped (has data/*.jsonl + commercial-properties.csv)
COSTAR_DATA_DIR=data/costar_kit/kit
# Matterport Model API: 'API key' from /costar-keys = TOKEN_ID, 'API token' = TOKEN_SECRET (HTTP Basic)
MATTERPORT_API_TOKEN_ID=
MATTERPORT_API_TOKEN_SECRET=
# Matterport Showcase SDK key (frontend also needs it: NEXT_PUBLIC_MATTERPORT_SDK_KEY in web/.env.local)
MATTERPORT_SDK_KEY=
# Long-life key, sent as the X-API-KEY header
VEXCEL_API_KEY=

# --- Data Engine overrides (defaults are fine; change once the docs confirm) ----
# Use the synthetic sample DB instead of data/hestia.duckdb (M0 / no sponsor data yet)
# HESTIA_DB_PATH=data/sample.duckdb
# 0 = also return spaces without a Matterport scan from query_spaces
HESTIA_REQUIRE_SCAN=1
# MATTERPORT_GRAPH_URL=https://api.matterport.com/api/models/graph
# MATTERPORT_SKYBOX_RES=2k
# Order of SkyboxPanorama.children (check one pano: 'up' should be the ceiling)
# MATTERPORT_FACE_ORDER=up,front,right,back,left,down
# auto | y | z  (auto = detected from scan heights)
# MATTERPORT_UP_AXIS=auto
# MATTERPORT_CAMERA_HEIGHT_M=1.25
# VEXCEL_BASE_URL=https://api.vexcelgroup.com/v2
# VEXCEL_LAYERS=urban,urban-r,wide-area,urban-g

# --- Server / funnel -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
FUNNEL_FILTER_LIMIT=200
FUNNEL_INSPECT_TOP=20
FUNNEL_FIT_TOP=5
