# Copy to .env and fill in. NEVER commit .env.
# Keys come from the CoStar Discord bot (/costar-keys) and your AWS/Anthropic accounts.

# --- Demo -------------------------------------------------------------------
# 1 = replay the cached demo run (works offline)
DEMO=0
# Replay only these business types from data/runs/demo_<type>.json (e.g. office), run the rest live
DEMO_REPLAY=
# 1 = a replay plans every layout again with the current planner and drops the recorded photo (use until a fresh run with photos is recorded)
DEMO_REPLAN=0

# --- LLM (agent, brief parsing, vision inspection) ---------------------------
# Everything AI runs on Amazon Bedrock: Claude (agent, scoring) and Stability AI (photos).
# bedrock | anthropic
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
# Newest Claude our AWS account can use (Opus 5.5 / Sonnet 5.5 are not enabled for it)
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
# Used when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Simplest for Bedrock: a Bedrock API key (AWS console -> Bedrock -> API keys). Leave the
# AWS_ACCESS_KEY_ID lines below empty when you use it.
AWS_BEARER_TOKEN_BEDROCK=
# Or standard AWS credentials (or use an AWS profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Image generation (Reimaginer): Stability AI on Bedrock, same AWS key ----------
# inpaint (furniture into the real photo) | condition (redraw from the plan image) | preview (no AI, plan image)
HERO_MODE=inpaint
# Images per round (2 rounds max), ~30 s each
HERO_VARIANTS=2
# 1 = a vision model scores realism/plan adherence of hero images (uses LLM_PROVIDER)
SCORER_LLM=1
# Matterport camera height above the floor, used when room floor heights aren't available
PANO_CAMERA_HEIGHT_M=1.55

# --- CoStar / Matterport / Vexcel (from /costar-keys) --------------------------
# Folder where the CoStar hackathon kit is unzipped (has data/*.jsonl + commercial-properties.csv)
COSTAR_DATA_DIR=data/costar_kit/kit
# Matterport Model API: 'API key' from /costar-keys = TOKEN_ID, 'API token' = TOKEN_SECRET (HTTP Basic)
MATTERPORT_API_TOKEN_ID=
MATTERPORT_API_TOKEN_SECRET=
# Matterport Showcase SDK key (frontend also needs it: NEXT_PUBLIC_MATTERPORT_SDK_KEY in web/.env.local)
MATTERPORT_SDK_KEY=
# Long-life key, sent as the X-API-KEY header
VEXCEL_API_KEY=

# --- Data Engine overrides (defaults are fine; change once the docs confirm) ----
# Use the synthetic sample DB instead of data/hestia.duckdb (M0 / no sponsor data yet)
# HESTIA_DB_PATH=data/sample.duckdb
# 0 = also return spaces without a Matterport scan from query_spaces
HESTIA_REQUIRE_SCAN=1
# MATTERPORT_GRAPH_URL=https://api.matterport.com/api/models/graph
# MATTERPORT_SKYBOX_RES=2k
# Order of SkyboxPanorama.children (check one pano: 'up' should be the ceiling)
# MATTERPORT_FACE_ORDER=up,front,right,back,left,down
# auto | y | z  (auto = detected from scan heights)
# MATTERPORT_UP_AXIS=auto
# MATTERPORT_CAMERA_HEIGHT_M=1.25
# VEXCEL_BASE_URL=https://api.vexcelgroup.com/v2
# VEXCEL_LAYERS=urban,urban-r,wide-area,urban-g

# --- Server / funnel -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
FUNNEL_FILTER_LIMIT=200
FUNNEL_INSPECT_TOP=20
FUNNEL_FIT_TOP=5
# Only for IMAGE_PROVIDER=bedrock_stability (the Bedrock inference profile of Stability's inpaint model)
STABILITY_MODEL_ID=us.stability.stable-image-inpaint-v1:0
